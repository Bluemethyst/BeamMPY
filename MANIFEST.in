include .gitignore .gitattributes AGENTS.md LICENSE THIRD_PARTY_NOTICES.md requirements.txt main.py
recursive-include .github *.yml
recursive-include tools *.py
recursive-include scripts *.py *.ps1 *.sh
recursive-include docs *.md
recursive-include tests *.py
recursive-include frontend *.json *.ts *.vue *.css *.html *.mjs
prune frontend/node_modules
prune frontend/test-results
prune frontend/playwright-report
prune tests/__pycache__
global-exclude *.pyc
